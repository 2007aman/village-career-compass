NODE_ENV=production
PORT=5000

# ---- PostgreSQL: choose ONE of the two options ----

# Option A - local / own PostgreSQL (recommended for development)
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your_postgres_password
PGDATABASE=village_career_compass
DB_SSL=false

# Option B - hosted PostgreSQL (Supabase "Transaction pooler" port 6543, Neon, Railway...)
# If DATABASE_URL is set it is used instead of Option A. Remove DB_SSL=false above for hosted DBs.
# DATABASE_URL=postgresql://postgres.xxxx:YOUR_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# Max connections PER server instance (instances x this must stay under your Supabase pooler limit)
DB_POOL_MAX=20

GEMINI_API_KEY=your_gemini_api_key

# Secret used to sign login sessions (min 32 chars). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=paste_a_long_random_string_here_at_least_32_characters

# Protects GET /api/admin/applications (send as header: x-admin-key)
ADMIN_API_KEY=change_me_to_a_long_random_string

# Comma-separated allowed origins. Leave empty to allow all.
CORS_ORIGIN=https://yourdomain.com

# SMTP (emails are skipped with a log message if these are empty)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your_app_password
MAIL_FROM="Village Career Compass <you@gmail.com>"
